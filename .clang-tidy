CheckOptions:
  # Identifier naming: configure per project to match existing conventions.
  # Uncomment and set the cases that match your project:
  # readability-identifier-naming.ClassCase:             CamelCase
  # readability-identifier-naming.FunctionCase:          lower_case
  # readability-identifier-naming.VariableCase:          lower_case
  # readability-identifier-naming.MemberSuffix:          '_'

  # Thresholds
  readability-function-size.LineThreshold:              120
  readability-function-size.StatementThreshold:         80
  readability-function-cognitive-complexity.Threshold:   40
  readability-magic-numbers.IgnoredIntegerValues:       '0;1;2;3;4;8;16;32;64;128;256;512;1024'
  readability-magic-numbers.IgnoredFloatingPointValues:  '0.0;0.5;1.0;2.0;-1.0'

  # Header-only: allow public member variables in structs
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  cppcoreguidelines-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true

  # Special member functions: allow sole default dtor
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  hicpp-special-member-functions.AllowSoleDefaultDtor: true
