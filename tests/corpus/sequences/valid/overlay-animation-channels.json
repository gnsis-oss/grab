{
  "schema_version": 1,
  "sequence": "overlay-animation-channels",
  "pacing": { "mode": "strict", "grace_ms": 0 },
  "steps": [
    { "id": "scale-only", "op": "overlay.add",
      "shape": { "ellipse":   { "center": [100, 100], "radius": 20 },
                 "stroke":    { "color": "#4ecea9", "width": 2 },
                 "animation": { "scale": { "easing": "in_out_cubic",
                                           "duration_ms": 200,
                                           "from": 0.25, "to": 1.0 } } } },

    { "id": "opacity-only", "op": "overlay.add",
      "shape": { "ellipse":   { "center": [160, 100], "radius": 20 },
                 "fill":      { "color": "#ed5a49" },
                 "animation": { "opacity": { "easing": "out_quad",
                                             "duration_ms": 150,
                                             "from": 0.0, "to": 1.0 } } } },

    { "id": "translate-only", "op": "overlay.add",
      "shape": { "rect":      { "x": 200, "y": 80, "w": 40, "h": 40 },
                 "fill":      { "color": "#edce59" },
                 "animation": { "translate": { "easing": "in_quad",
                                               "duration_ms": 300,
                                               "dx": 120.0, "dy": -45.5 } } } },

    { "id": "reveal-only", "op": "overlay.add",
      "shape": { "rect":      { "x": 260, "y": 80, "w": 40, "h": 40 },
                 "fill":      { "color": "#4ecea9" },
                 "animation": { "reveal": { "easing": "in_cubic",
                                            "duration_ms": 250,
                                            "axis": "y", "from_edge": "max",
                                            "from": 0.0, "to": 1.0 } } } },

    { "id": "channel-defaults-only-duration", "op": "overlay.add",
      "shape": { "rect":      { "x": 320, "y": 80, "w": 40, "h": 40 },
                 "fill":      { "color": "#4ecea9" },
                 "animation": { "scale":     { "duration_ms": 100 },
                                "opacity":   { "duration_ms": 100 },
                                "translate": { "duration_ms": 100 },
                                "reveal":    { "duration_ms": 100 } } } },

    { "id": "zero-duration-channel", "op": "overlay.add",
      "shape": { "rect":      { "x": 380, "y": 80, "w": 40, "h": 40 },
                 "fill":      { "color": "#ed5a49" },
                 "animation": { "opacity": { "duration_ms": 0 } } } },

    { "id": "all-four-channels", "op": "overlay.add", "handle": "animated",
      "shape": { "polygon":   [[0, 0], [60, 0], [60, 60], [0, 60]],
                 "stroke":    { "color": "#ffffffcc", "width": 2 },
                 "fill":      { "color": "#4ecea922" },
                 "band":      "annotation",
                 "z":         4,
                 "animation": { "scale":     { "easing": "out_cubic",
                                               "duration_ms": 180,
                                               "from": 0.8, "to": 1.2 },
                                "opacity":   { "easing": "in_out_quad",
                                               "duration_ms": 180,
                                               "from": 0.1, "to": 0.9 },
                                "translate": { "easing": "linear",
                                               "duration_ms": 180,
                                               "dx": -20.0, "dy": 20.0 },
                                "reveal":    { "easing": "in_out_cubic",
                                               "duration_ms": 180,
                                               "axis": "x", "from_edge": "min",
                                               "from": 0.0, "to": 1.0 } } } },

    { "id": "retire-the-animated-shape", "op": "overlay.remove", "handle": "animated" }
  ]
}
