{
  "schema_version": 1,
  "sequence": "overlay-lifetimes",
  "pacing": { "mode": "strict", "grace_ms": 0 },
  "steps": [
    { "id": "lifetime-absent", "op": "overlay.add",
      "shape": { "rect": { "x": 0, "y": 0, "w": 20, "h": 20 },
                 "fill": { "color": "#4ecea9" } } },

    { "id": "lifetime-persistent", "op": "overlay.add",
      "shape": { "rect":     { "x": 30, "y": 0, "w": 20, "h": 20 },
                 "fill":     { "color": "#4ecea9" },
                 "lifetime": "persistent" } },

    { "id": "lifetime-ttl", "op": "overlay.add", "handle": "flash",
      "shape": { "rect":     { "x": 60, "y": 0, "w": 20, "h": 20 },
                 "fill":     { "color": "#ed5a49" },
                 "lifetime": { "ttl_ms": 500 } } },

    { "id": "lifetime-fade", "op": "overlay.add",
      "shape": { "rect":     { "x": 90, "y": 0, "w": 20, "h": 20 },
                 "fill":     { "color": "#edce59" },
                 "lifetime": { "fade_ms": 750 } } },

    { "id": "lifetime-zero-ttl", "op": "overlay.add",
      "shape": { "rect":     { "x": 120, "y": 0, "w": 20, "h": 20 },
                 "fill":     { "color": "#edce59" },
                 "lifetime": { "ttl_ms": 0 } } },

    { "id": "wait-past-the-ttl", "op": "time.wait", "ms": 600 },

    { "id": "remove-an-expired-handle", "op": "overlay.remove", "handle": "flash" }
  ]
}
