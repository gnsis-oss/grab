    //
    //   0 = Off      nothing is compiled in
    //   1 = Nominal  lifecycle, errors, rejected preconditions
    //   2 = Verbose  branch decisions, state transitions, per-step summaries
    //   3 = Debug    per-sample detail
    inline constexpr int compileLevel = @GRAB_LOG_COMPILE_LEVEL@;

}    // namespace grab::log
