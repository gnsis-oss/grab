// <binaryDir>/generated/kernel/support/log_config.hpp.
//
// Each build directory generates its own copy, so `release` compiles logging
// out and `asan` compiles it in with no shared preprocessor state and nothing
// to keep in sync by hand.

namespace grab::log
{

    // Compile-time ceiling for this build directory. Levels above it are
