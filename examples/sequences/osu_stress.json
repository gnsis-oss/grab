{
  "schema_version": 1,
  "sequence": "osu-stress",
  "pacing": { "mode": "grace", "grace_ms": 20 },
  "steps": [
    { "id": "intro-wait",  "op": "time.wait", "ms": 400 },
    { "id": "intro-park",  "op": "input.warp", "to": [960, 540] },

    { "id": "line-sweep",  "op": "input.follow",
      "curve": [[960, 540], [400, 200], [1500, 200], [960, 540]],
      "options": { "steps": 64, "step_dwell_ms": 4, "path": "cubic" } },
    { "id": "line-settle", "op": "time.wait", "ms": 150 },

    { "id": "hit-01", "op": "input.move", "to": [300, 200],
      "options": { "steps": 24, "step_dwell_ms": 6 } },
    { "id": "tap-01", "op": "input.click", "button": "left" },
    { "id": "hit-02", "op": "input.move", "to": [420, 320],
      "options": { "steps": 18, "step_dwell_ms": 5 } },
    { "id": "tap-02", "op": "input.click", "button": "left" },
    { "id": "hit-03", "op": "input.move", "to": [300, 440],
      "options": { "steps": 18, "step_dwell_ms": 5 } },
    { "id": "tap-03", "op": "input.click", "button": "left" },
    { "id": "hit-04", "op": "input.move", "to": [420, 560],
      "options": { "steps": 18, "step_dwell_ms": 5 } },
    { "id": "tap-04", "op": "input.click", "button": "left" },
    { "id": "hit-05", "op": "input.move", "to": [300, 680],
      "options": { "steps": 18, "step_dwell_ms": 5 } },
    { "id": "tap-05", "op": "input.click", "button": "left" },
    { "id": "hit-06", "op": "input.move", "to": [420, 800],
      "options": { "steps": 18, "step_dwell_ms": 5 } },
    { "id": "tap-06", "op": "input.click", "button": "left" },
    { "id": "hit-07", "op": "input.move", "to": [540, 680],
      "options": { "steps": 16, "step_dwell_ms": 4 } },
    { "id": "tap-07", "op": "input.click", "button": "left" },
    { "id": "hit-08", "op": "input.move", "to": [660, 560],
      "options": { "steps": 16, "step_dwell_ms": 4 } },
    { "id": "tap-08", "op": "input.click", "button": "left" },

    { "id": "stream-rest", "op": "time.wait", "ms": 250 },

    { "id": "hit-09", "op": "input.move", "to": [960, 180],
      "options": { "steps": 28, "step_dwell_ms": 6 } },
    { "id": "tap-09", "op": "input.click", "button": "left" },
    { "id": "hit-10", "op": "input.move", "to": [1180, 540],
      "options": { "steps": 28, "step_dwell_ms": 6 } },
    { "id": "tap-10", "op": "input.click", "button": "left" },
    { "id": "hit-11", "op": "input.move", "to": [740, 320],
      "options": { "steps": 28, "step_dwell_ms": 6 } },
    { "id": "tap-11", "op": "input.click", "button": "left" },
    { "id": "hit-12", "op": "input.move", "to": [1180, 320],
      "options": { "steps": 28, "step_dwell_ms": 6 } },
    { "id": "tap-12", "op": "input.click", "button": "left" },
    { "id": "hit-13", "op": "input.move", "to": [740, 540],
      "options": { "steps": 28, "step_dwell_ms": 6 } },
    { "id": "tap-13", "op": "input.click", "button": "left" },

    { "id": "star-rest", "op": "time.wait", "ms": 300 },

    { "id": "slider-a-grab",   "op": "input.move", "to": [1250, 200],
      "options": { "steps": 30, "step_dwell_ms": 6 } },
    { "id": "slider-a-hold",   "op": "input.press", "button": "left" },
    { "id": "slider-a-follow", "op": "input.follow",
      "curve": [[1250, 200], [1400, 120], [1600, 140], [1720, 260]],
      "options": { "steps": 48, "step_dwell_ms": 5, "path": "cubic" } },
    { "id": "slider-a-drop",   "op": "input.release", "button": "left" },
    { "id": "slider-a-rest",   "op": "time.wait", "ms": 200 },

    { "id": "hit-14", "op": "input.move", "to": [250, 900],
      "options": { "steps": 36, "step_dwell_ms": 5 } },
    { "id": "tap-14", "op": "input.click", "button": "left" },
    { "id": "hit-15", "op": "input.move", "to": [1670, 900],
      "options": { "steps": 36, "step_dwell_ms": 5 } },
    { "id": "tap-15", "op": "input.click", "button": "left" },
    { "id": "hit-16", "op": "input.move", "to": [250, 150],
      "options": { "steps": 36, "step_dwell_ms": 5 } },
    { "id": "tap-16", "op": "input.click", "button": "left" },
    { "id": "hit-17", "op": "input.move", "to": [1670, 150],
      "options": { "steps": 36, "step_dwell_ms": 5 } },
    { "id": "tap-17", "op": "input.click", "button": "left" },
    { "id": "hit-18", "op": "input.move", "to": [860, 400],
      "options": { "steps": 24, "step_dwell_ms": 5 } },
    { "id": "tap-18", "op": "input.click", "button": "left" },

    { "id": "jump-rest", "op": "time.wait", "ms": 300 },

    { "id": "square-approach", "op": "input.move", "to": [600, 300],
      "options": { "steps": 30, "step_dwell_ms": 6 } },
    { "id": "square-settle",   "op": "time.wait", "ms": 180 },
    { "id": "square-grab",     "op": "input.press", "button": "left" },
    { "id": "square-hold",     "op": "time.wait", "ms": 250 },
    { "id": "square-carry-a",  "op": "input.move", "to": [1000, 300],
      "options": { "steps": 40, "step_dwell_ms": 7 } },
    { "id": "square-carry-b",  "op": "input.move", "to": [1000, 700],
      "options": { "steps": 40, "step_dwell_ms": 7 } },
    { "id": "square-carry-c",  "op": "input.follow",
      "curve": [[1000, 700], [800, 820], [500, 820], [380, 700]],
      "options": { "steps": 44, "step_dwell_ms": 6, "path": "cubic" } },
    { "id": "square-drop",     "op": "input.release", "button": "left" },
    { "id": "square-rest",     "op": "time.wait", "ms": 300 },

    { "id": "square2-approach", "op": "input.move", "to": [380, 700],
      "options": { "steps": 20, "step_dwell_ms": 5 } },
    { "id": "square2-grab",     "op": "input.press", "button": "left" },
    { "id": "square2-carry",    "op": "input.move", "to": [1500, 450],
      "options": { "steps": 56, "step_dwell_ms": 6 } },
    { "id": "square2-drop",     "op": "input.release", "button": "left" },

    { "id": "spin-enter",  "op": "input.move", "to": [960, 540],
      "options": { "steps": 30, "step_dwell_ms": 5 } },
    { "id": "spin-hold",   "op": "input.press", "button": "left" },
    { "id": "spin-arc-1",  "op": "input.follow",
      "curve": [[960, 540], [1200, 380], [1200, 700], [960, 540]],
      "options": { "steps": 40, "step_dwell_ms": 4, "path": "cubic" } },
    { "id": "spin-arc-2",  "op": "input.follow",
      "curve": [[960, 540], [720, 380], [720, 700], [960, 540]],
      "options": { "steps": 40, "step_dwell_ms": 4, "path": "cubic" } },
    { "id": "spin-arc-3",  "op": "input.follow",
      "curve": [[960, 540], [1200, 700], [720, 700], [960, 540]],
      "options": { "steps": 40, "step_dwell_ms": 4, "path": "cubic" } },
    { "id": "spin-release", "op": "input.release", "button": "left" },
    { "id": "spin-rest",    "op": "time.wait", "ms": 250 },

    { "id": "hit-19", "op": "input.move", "to": [1300, 750],
      "options": { "steps": 26, "step_dwell_ms": 5 } },
    { "id": "tap-19", "op": "input.click", "button": "left" },
    { "id": "hit-20", "op": "input.move", "to": [1420, 820],
      "options": { "steps": 14, "step_dwell_ms": 4 } },
    { "id": "tap-20", "op": "input.click", "button": "left" },
    { "id": "hit-21", "op": "input.move", "to": [1540, 850],
      "options": { "steps": 14, "step_dwell_ms": 4 } },
    { "id": "tap-21", "op": "input.click", "button": "right" },
    { "id": "hit-22", "op": "input.move", "to": [1660, 820],
      "options": { "steps": 14, "step_dwell_ms": 4 } },
    { "id": "tap-22", "op": "input.click", "button": "left" },
    { "id": "hit-23", "op": "input.move", "to": [1720, 720],
      "options": { "steps": 14, "step_dwell_ms": 4 } },
    { "id": "tap-23", "op": "input.click", "button": "middle" },
    { "id": "hit-24", "op": "input.move", "to": [1500, 600],
      "options": { "steps": 20, "step_dwell_ms": 5 } },
    { "id": "tap-24", "op": "input.click", "button": "left" },

    { "id": "wheel-park", "op": "input.move", "to": [960, 960],
      "options": { "steps": 22, "step_dwell_ms": 5 } },
    { "id": "wheel-up",   "op": "input.scroll", "dx": 0, "dy": -3 },
    { "id": "wheel-rest", "op": "time.wait", "ms": 120 },
    { "id": "wheel-down", "op": "input.scroll", "dx": 0, "dy": 3 },
    { "id": "wheel-side", "op": "input.scroll", "dx": 2, "dy": 0 },

    { "id": "chord-down", "op": "input.key_down", "key": "Control_L" },
    { "id": "chord-key",  "op": "input.key",      "key": "a" },
    { "id": "chord-up",   "op": "input.key_up",   "key": "Control_L" },

    { "id": "outro-line", "op": "input.follow",
      "curve": [[1500, 600], [1100, 250], [500, 250], [200, 600]],
      "options": { "steps": 72, "step_dwell_ms": 4, "path": "cubic" } },
    { "id": "outro-wait", "op": "time.wait", "ms": 350 },
    { "id": "outro-shot", "op": "screen.capture", "out": "osu-stress-final.png" }
  ]
}
